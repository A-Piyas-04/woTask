{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "woTask",
  "version": "0.1.0",
  "identifier": "com.wotask.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "woTask",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 500,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "resizable": true,
        "backgroundColor": "#080a12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "A-Piyas-04",
    "shortDescription": "Offline 3D task manager",
    "longDescription": "A task manager that puts your work in space. Offline, local-first, no account and no sync.",
    "copyright": "Copyright (c) 2026 A-Piyas-04",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "woTask",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
